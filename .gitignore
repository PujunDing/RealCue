# RealCue · repository hygiene
# Only source code, docs, reports, test sources and small scripts are published.
# Local toolchain, emulator images, SDK binaries and build outputs stay on disk.

# --- Private workspace / agent memory (never publish) ---
.workbuddy/

# --- Local toolchain: ~14 GB, regenerated by runtime/setup_*.py ---
InspireFace-LocalRun/runtime/android/
InspireFace-LocalRun/runtime/avd/
InspireFace-LocalRun/runtime/downloads/
InspireFace-LocalRun/runtime/gradle/
InspireFace-LocalRun/runtime/gradle-home/
InspireFace-LocalRun/runtime/pylib/
InspireFace-LocalRun/runtime/java-user/
InspireFace-LocalRun/runtime/sdk/
InspireFace-LocalRun/runtime/tmp/
InspireFace-LocalRun/runtime/__pycache__/

# --- Build outputs and IDE state ---
**/build/
**/.gradle/
**/.idea/
**/captures/
*.iml
*.hprof

# --- Binaries: APK exceeds GitHub's 100 MB per-file limit;
#     AAR is the upstream InspireFace SDK (kept locally via sdk.local.properties) ---
*.apk
*.aar
*.jks
*.keystore
*.img
*.qcow2
*.zip

# --- Machine-local config; copy from the *.example templates instead ---
InspireFace-LocalRun/android-demo/local.properties
InspireFace-LocalRun/android-demo/sdk.local.properties
InspireFace-LocalRun/android-demo/plus.local.properties

# --- OS noise ---
.DS_Store
Thumbs.db
